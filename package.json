{
  "name": "contractme-api",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rimraf dist && rimraf .cache && rimraf .tsbuildinfo",
    "build": "nest build",
    "start": "NODE_ENV=production nest start",
    "dev": "cross-env NODE_ENV=dev nest build && nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "migration:create": "node -r ts-node/register/transpile-only ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./src/database/data-source.ts",
    "migration:run": "npm run db:target --silent && node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npm run db:target --silent && node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/database/data-source.ts",
    "migration:show": "npm run db:target --silent && node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d ./dist/database/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d ./dist/database/data-source.js",
    "migration:show:prod": "typeorm migration:show -d ./dist/database/data-source.js",
    "schema:log": "npm run db:target --silent && node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:log -d ./src/database/data-source.ts",
    "schema:snapshot": "npm run db:target --silent && node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/schema-snapshot.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart api",
    "docker:logs": "docker compose logs -f api",
    "docker:ps": "docker compose ps",
    "docker:sh": "docker compose exec api sh",
    "docker:db": "docker compose exec mysql mysql -u root -p",
    "docker:config": "docker compose config",
    "docker:reset": "docker compose down -v",
    "db:target": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/print-db-target.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-ses": "^3.883.0",
    "@aws-sdk/client-sesv2": "^3.883.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "10.0.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "7.2.0",
    "@nestjs/typeorm": "10.0.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.6",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "typeorm": "0.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "10.0.0",
    "@nestjs/schematics": "10.0.0",
    "@nestjs/testing": "10.0.0",
    "@types/express": "4.17.17",
    "@types/jest": "29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "20.3.1",
    "@types/supertest": "2.0.12",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.15.0",
    "jest": "29.5.0",
    "prettier": "3.0.0",
    "source-map-support": "0.5.21",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
