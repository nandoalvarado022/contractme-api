# Copy to the repo root as `.env` and fill in the blanks.
# Never commit the filled file: `.env` is gitignored.

# AUTH
# openssl rand -base64 48
JWT_SECRET=

# DB driver, shared by both families below.
DB_TYPE=mysql

# DB local — a MySQL instance you run natively, outside Docker.
# Selected whenever NODE_ENV is not `production`.
DB_LOCAL_HOST=localhost
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DB_LOCAL_DATABASE=contract_me
DB_LOCAL_PORT=3306

# DB remote — the MySQL service in docker-compose.yml.
# Selected whenever NODE_ENV is `production`, and it is also the single source
# of truth for that container's database name, user and password.
#   - From the host (typeorm CLI, a GUI client): DB_REMOTE_HOST:DB_REMOTE_PORT
#   - From the api container: compose overrides these to mysql:3306
# Keep DB_REMOTE_PORT off 3306 so it does not collide with the native instance.
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_USERNAME=contractme
DB_REMOTE_PASSWORD=
DB_REMOTE_DATABASE=contract_me
DB_REMOTE_PORT=3310

# Compose-only. The mysql service refuses to start without it.
MYSQL_ROOT_PASSWORD=

# Set to `true` to apply pending migrations on boot. Off by default.
DB_MIGRATIONS_RUN=false

# ENVIRONMENT
# PORT applies when running outside Docker. In the stack the container always
# listens on 3000 and API_HOST_PORT controls the published host port.
NODE_ENV=production
PORT=5050
API_HOST_PORT=5050

# CLOUDFRONT — no trailing slash.
CLOUDFRONT_URL=https://assets.contractme.cloud

# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# BREVO API
BREVO_KEY=
BREVO_SECRET_KEY=

# BREVO SMTP
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SMTP_HOST=smtp-relay.sendinblue.com

# AWS SES
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=us-east-1
