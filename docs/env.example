# Copy to the repo root as `.env` and fill in the blanks.
# Never commit the filled file: `.env` is gitignored.

# AUTH
# openssl rand -base64 48
JWT_SECRET=

# ------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------
# Canonical credentials for the mysql service in docker-compose.yml. The api
# service derives its whole DB_REMOTE_* connection from these four values, so
# a containerized deployment needs nothing else.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=contract_me
MYSQL_USER=contractme
MYSQL_PASSWORD=

# Loopback port the mysql container publishes on the host. Kept off 3306 so it
# does not collide with a MySQL running natively on the same machine.
MYSQL_HOST_PORT=3310

# src/database/data-source.ts picks the env family by NODE_ENV:
#   production      -> DB_REMOTE_*
#   anything else   -> DB_LOCAL_*

# DB local — a MySQL you run natively, for `npm run dev` outside Docker.
DB_TYPE=mysql
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=contract_me
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=

# DB remote — NOT needed by the api container: compose injects this family
# from the MYSQL_* values above and points it at the mysql service.
# Fill it in only to run the typeorm CLI from the host against the container,
# in which case it must mirror MYSQL_* on the published loopback port.
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3310
DB_REMOTE_DATABASE=contract_me
DB_REMOTE_USERNAME=contractme
DB_REMOTE_PASSWORD=

# Set to `true` to apply pending migrations on boot. Off by default.
DB_MIGRATIONS_RUN=false

# ------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------
NODE_ENV=production

# PORT applies when running outside Docker. In the stack the container always
# listens on 3000; these two control how it is published on the host.
PORT=3000
API_HOST_PORT=3000
# 127.0.0.1 keeps the API reachable only through the reverse proxy that
# terminates TLS. Set to 0.0.0.0 on a host with no proxy in front.
API_BIND_ADDRESS=127.0.0.1

# CLOUDFRONT — no trailing slash.
CLOUDFRONT_URL=https://assets.contractme.cloud

# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# BREVO API
BREVO_KEY=
BREVO_SECRET_KEY=

# BREVO SMTP
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SMTP_HOST=smtp-relay.sendinblue.com

# AWS SES
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=us-east-1
