# Copy to the repo root as `.env` and fill in the blanks.

# `production` selects the DB_REMOTE_* connection. Any other value selects DB_LOCAL_*.
NODE_ENV=production
PORT=3000

DB_TYPE=mysql

DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_DATABASE=contract_me
DB_LOCAL_USERNAME=
DB_LOCAL_PASSWORD=

DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3310
DB_REMOTE_DATABASE=contract_me
DB_REMOTE_USERNAME=
DB_REMOTE_PASSWORD=

# Set to `true` to apply pending migrations on boot. Off by default.
DB_MIGRATIONS_RUN=false

# openssl rand -base64 48
JWT_SECRET=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# No trailing slash.
CLOUDFRONT_URL=https://cdn.example.com

BREVO_KEY=
BREVO_SECRET_KEY=
BREVO_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

DD_LOGS_INJECTION=true
